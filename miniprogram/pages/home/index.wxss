.home { display:flex; flex-direction:column; }
.system-row { display:flex; align-items:center; gap:12rpx; color:#778194; font-size:19rpx; letter-spacing:2rpx; }
.system-dot { width:12rpx; height:12rpx; border-radius:50%; background:#30a46c; }
.hero { margin-top:15vh; }
.title { margin-top:24rpx; color:#172033; font-size:64rpx; font-weight:800; letter-spacing:-2rpx; }
.subtitle { margin-top:22rpx; color:#536074; font-size:30rpx; line-height:1.6; }
.tag { display:inline-block; margin-top:30rpx; padding:10rpx 18rpx; border:1rpx solid #d6dce6; border-radius:8rpx; color:#526076; background:#edf0f5; font-size:23rpx; }
.notice { margin-top:34rpx; padding:20rpx 24rpx; border-radius:12rpx; color:#8a5a00; background:#fff5d8; font-size:25rpx; }
.actions { margin-top:auto; padding-top:80rpx; }
.start { width:100%; padding:10rpx; }
.resume { padding:28rpx; }
.resume-label { margin-bottom:24rpx; color:#4d596c; font-size:26rpx; }
.resume button { width:100%; }
.text-button { margin-top:14rpx; color:#6a7485; background:transparent; font-size:25rpx; font-weight:400; }
.disclaimer { margin-top:36rpx; white-space:pre-line; color:#7b8493; font-size:23rpx; line-height:1.7; }

