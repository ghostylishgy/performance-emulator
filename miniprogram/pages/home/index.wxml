<view wx:if="{{openingVisible}}" class="opening" bindtap="skipOpening">
  <view class="opening-mark"><view class="opening-flame"></view></view>
  <view class="opening-brand">烛龙实验室</view>
  <view class="opening-product">绩效内测会</view>
  <view class="opening-status">
    <view>正在加载年度工作痕迹……</view>
    <view>正在连接组织……</view>
    <view>正在搜索优秀名额……</view>
  </view>
  <view class="opening-punchline"><view>员工档案未找到。</view><view>问题不大，系统一般也不看这个。</view></view>
  <view class="opening-skip">SYSTEM BOOTING · 点击跳过</view>
</view>

<view wx:else class="page-shell home">
  <view class="brand-row">
    <view class="brand-fire"></view>
    <view class="brand-name">烛龙实验室｜绩效内测会</view>
  </view>
  <view class="hero">
    <view class="eyebrow beta-label">PERFORMANCE REVIEW BETA</view>
    <view class="title">{{title}}</view>
    <view class="subtitle">{{subtitle}}</view>
    <view class="hook">
      <view>你努力了多少，和组织承认你努力了多少，</view>
      <view class="hook-emphasis">通常不是一回事。</view>
      <view class="hook-note">判定依据：一些很严谨的职场玄学</view>
    </view>
  </view>

  <view wx:if="{{versionNotice}}" class="notice">{{versionNotice}}</view>

  <view class="actions">
    <block wx:if="{{hasResume}}">
      <view class="resume panel">
        <view class="resume-kicker">上次的组织流程还没放过你</view>
        <view class="resume-label">{{resumeLabel}}</view>
        <button class="primary-button" bindtap="resume">接着打</button>
        <button class="text-button" bindtap="restart">重新开始</button>
      </view>
    </block>
    <block wx:else>
      <view class="cta-prompt">不信，但想试试<text class="prompt-arrow">↘</text></view>
      <button class="primary-button start" bindtap="start">开始打分<text class="button-spark">✦</text></button>
    </block>
  </view>

  <view class="light-tip">{{description}}</view>
  <view class="disclaimer">{{disclaimer}}</view>
  <ad-slot slot="{{homeAdSlot}}" />
</view>
