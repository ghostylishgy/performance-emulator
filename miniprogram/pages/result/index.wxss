.result-loading-page { display:flex; align-items:center; }
.result-loading { width:100%; padding:46rpx 34rpx; }
.loading-mark { display:flex; align-items:center; justify-content:center; width:74rpx; height:74rpx; margin:0 auto; border:3rpx solid #cbd7f3; border-top-color:#2457d6; border-radius:50%; animation:result-spin 1.15s linear infinite; }
.loading-core { width:18rpx; height:18rpx; border-radius:50%; background:#2457d6; }
.loading-title { margin-top:34rpx; color:#172033; font-size:36rpx; font-weight:700; text-align:center; }
.loading-list { margin-top:40rpx; }
.loading-line { display:flex; gap:18rpx; margin-top:25rpx; color:#a0a8b5; font-size:26rpx; transition:color .2s ease; }
.loading-line.active { color:#2457d6; font-weight:600; }
.loading-line.done { color:#536074; }
.loading-status { width:28rpx; }
.loading-disclaimer { margin-top:42rpx; padding-top:26rpx; border-top:1rpx solid #e3e8ef; color:#7a8494; font-size:23rpx; line-height:1.65; }
@keyframes result-spin { to { transform:rotate(360deg); } }
.result-eyebrow { margin-bottom:20rpx; text-align:center; }
.calibration,.metrics,.hidden { margin-top:28rpx; padding:34rpx 30rpx; }
.section-title { color:#172033; font-size:31rpx; font-weight:700; }
.outcome-flow { margin-top:30rpx; text-align:center; }
.outcome-flow > view { display:flex; justify-content:space-between; align-items:center; }
.flow-label { color:#677287; font-size:26rpx; }
.flow-value { color:#172033; font-size:40rpx; font-weight:800; }
.flow-value.accent { color:#2457d6; }
.arrow { display:block !important; margin:8rpx 0; color:#9aa2af; }
.reason { margin-top:28rpx; padding:22rpx 24rpx; border-radius:12rpx; color:#485469; background:#f0f3f7; font-size:25rpx; line-height:1.65; }
.hidden { border-color:#d7c58e; background:#fffaf0; }
.hidden-title { white-space:pre-line; color:#6e5100; font-size:34rpx; font-weight:800; line-height:1.45; }
.hidden-copy { margin-top:16rpx; color:#7f6b34; font-size:25rpx; }
.result-actions { display:flex; gap:18rpx; margin:36rpx 0; }
.result-actions button { flex:1; padding:8rpx; }
.disclaimer { margin:32rpx 8rpx 0; white-space:pre-line; color:#818a99; font-size:22rpx; line-height:1.7; }
.reflection-backdrop { position:fixed; z-index:20; inset:0; display:flex; align-items:flex-end; padding:28rpx; box-sizing:border-box; background:rgba(17,24,39,.58); }
.reflection-modal { width:100%; max-height:86vh; overflow-y:auto; padding:22rpx; box-sizing:border-box; border-radius:26rpx 26rpx 18rpx 18rpx; background:#f4f6f9; box-shadow:0 -18rpx 60rpx rgba(15,23,42,.24); animation:reflection-rise .24s ease-out; }
.reflection-system-label { padding:8rpx 8rpx 20rpx; color:#677287; font-size:20rpx; letter-spacing:3rpx; }
.reflection-modal reflection-card { display:block; }
.reflection-close { margin-top:18rpx; color:#334155; background:#e4e9f0; }
@keyframes reflection-rise { from { opacity:0; transform:translateY(40rpx); } to { opacity:1; transform:translateY(0); } }
