.result-loading-page { display:flex; align-items:center; background:radial-gradient(circle at 85% 14%,rgba(215,194,218,.38),transparent 24%),linear-gradient(160deg,#fffaf6 0,var(--color-page) 100%); }
.result-loading { position:relative; width:100%; overflow:hidden; padding:var(--space-lg) 30rpx 36rpx; border-top:8rpx solid var(--color-primary); }
.result-loading::after { content:"INTERNAL ONLY"; position:absolute; right:22rpx; bottom:18rpx; color:rgba(137,101,142,.18); font-size:20rpx; font-weight:900; letter-spacing:3rpx; transform:rotate(-5deg); }
.loading-kicker { display:table; margin:0 auto; padding:7rpx 11rpx; border-radius:var(--radius-tag); color:var(--color-secondary-strong); background:var(--color-secondary-pale); font-size:19rpx; font-weight:800; letter-spacing:2rpx; text-align:center; }
.loading-symbol { position:relative; width:190rpx; height:190rpx; margin:30rpx auto 12rpx; }
.orbit { position:absolute; border:2rpx dashed rgba(137,101,142,.28); border-radius:50%; }
.orbit::after { content:""; position:absolute; width:13rpx; height:13rpx; border-radius:50%; background:var(--color-primary); box-shadow:0 0 0 7rpx var(--color-primary-pale); }
.orbit-one { inset:10rpx; animation:orbit-spin 4s linear infinite; }
.orbit-one::after { right:18rpx; top:6rpx; }
.orbit-two { inset:34rpx; border-style:solid; animation:orbit-spin 5.4s linear infinite reverse; }
.orbit-two::after { left:1rpx; bottom:27rpx; background:var(--color-accent-strong); box-shadow:0 0 0 7rpx var(--color-accent-soft); }
.symbol-core { position:absolute; inset:57rpx; display:flex; align-items:center; justify-content:center; border:3rpx solid var(--color-primary); border-radius:18rpx; color:var(--color-primary-strong); background:var(--color-primary-pale); font-size:34rpx; font-weight:900; transform:rotate(-4deg); box-shadow:8rpx 8rpx 0 var(--color-accent); }
.symbol-spark { position:absolute; right:5rpx; bottom:16rpx; color:var(--color-primary); font-size:27rpx; }
.loading-title { margin-top:20rpx; color:var(--color-text); font-size:39rpx; font-weight:900; text-align:center; }
.loading-active-line { display:flex; align-items:flex-start; justify-content:center; gap:17rpx; min-height:78rpx; margin-top:38rpx; color:var(--color-secondary-strong); font-size:27rpx; font-weight:700; line-height:1.55; text-align:center; animation:reveal-in .22s ease-out; }
.loading-status { flex:0 0 28rpx; width:28rpx; color:var(--color-primary); }
.loading-progress { display:flex; justify-content:center; gap:12rpx; margin-top:24rpx; }
.loading-progress-dot { width:12rpx; height:12rpx; border-radius:50%; background:var(--color-border); transition:background .2s ease,transform .2s ease; }
.loading-progress-dot.active { background:var(--color-primary); transform:scale(1.12); }

.result-page { background:radial-gradient(circle at 90% 10%,rgba(215,194,218,.28),transparent 20%),linear-gradient(180deg,#fffaf6 0,var(--color-page) 430rpx); }
.result-head { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.result-brand { display:flex; align-items:center; gap:10rpx; color:var(--color-text-secondary); font-size:20rpx; font-weight:800; }
.brand-dot { width:13rpx; height:13rpx; border-radius:50%; background:var(--color-primary); box-shadow:0 0 0 6rpx var(--color-primary-pale); }
.result-file-id { flex:0 0 auto; padding:6rpx 10rpx; border:1rpx solid var(--color-border); border-radius:var(--radius-tag); color:var(--color-secondary-strong); background:rgba(255,253,249,.74); font-size:18rpx; font-weight:800; letter-spacing:2rpx; }

.reveal-card { margin-top:var(--space-md); padding:34rpx 30rpx; animation:reveal-in .28s ease-out both; }
.section-kicker { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.kicker-pill { display:inline-block; padding:7rpx 12rpx; border-radius:var(--radius-tag); color:var(--color-secondary-strong); background:var(--color-secondary-pale); font-size:19rpx; font-weight:800; letter-spacing:2rpx; }
.kicker-pill-brand { color:var(--color-primary-ink); background:var(--color-primary-pale); letter-spacing:3rpx; }
.kicker-index { color:var(--color-text-muted-readable); font-size:20rpx; font-weight:800; letter-spacing:2rpx; font-variant-numeric:tabular-nums; }
.kicker-note { color:var(--color-secondary-strong); font-size:19rpx; font-weight:700; }

.persona-reveal { position:relative; overflow:hidden; border-top:8rpx solid var(--color-primary); background:linear-gradient(145deg,var(--color-card) 0,#fff7fa 100%); }
.persona-name { position:relative; z-index:1; margin-top:var(--space-md); color:var(--color-primary-ink); font-size:var(--text-display); font-weight:900; line-height:var(--leading-tight); letter-spacing:-2rpx; }
.persona-copy { position:relative; z-index:1; margin-top:var(--space-sm); color:var(--color-text); font-size:var(--text-subtitle); font-weight:700; line-height:var(--leading-normal); }
.reveal-button { width:100%; min-height:88rpx; margin-top:24rpx; }

.death-reveal { border-color:rgba(220,174,55,.34); background:linear-gradient(145deg,#fffdf8,var(--color-accent-soft)); }
.death-reveal .kicker-pill { color:#65500f; background:rgba(240,202,106,.34); }
.death-label { display:inline-block; margin-top:20rpx; padding:11rpx 17rpx; border:2rpx solid rgba(166,110,41,.26); border-radius:7rpx; color:#6f5318; background:var(--color-accent); font-size:40rpx; font-weight:900; transform:rotate(-1deg); }
.death-note { margin-top:20rpx; color:#806b3b; font-size:var(--text-caption); }

.evidence-reveal { background:var(--color-card); }
.evidence-item { position:relative; display:flex; align-items:flex-start; gap:18rpx; margin-top:18rpx; padding:22rpx 20rpx; border:1rpx solid var(--color-divider); border-radius:16rpx; background:#fcfaf7; }
.evidence-index { flex:0 0 42rpx; display:flex; align-items:center; justify-content:center; width:42rpx; height:42rpx; border-radius:9rpx; color:var(--color-text-inverse); background:var(--color-secondary-strong); font-size:20rpx; font-weight:800; transform:rotate(-2deg); }
.evidence-text { color:var(--color-text); font-size:var(--text-body); line-height:var(--leading-normal); }

.score-reveal { position:relative; overflow:hidden; border-top:8rpx solid var(--color-accent-strong); text-align:center; background:radial-gradient(circle at 86% 12%,rgba(240,202,106,.22),transparent 25%),var(--color-card); }
.final-score { position:relative; z-index:1; margin-top:18rpx; color:var(--color-primary-ink); font-size:var(--text-headline); font-weight:900; line-height:1.05; letter-spacing:-2rpx; font-variant-numeric:tabular-nums; }
.score-subtitle { color:var(--color-text); font-size:30rpx; font-weight:900; }
.score-meta { display:inline-block; margin-top:var(--space-sm); padding:8rpx 12rpx; border-radius:var(--radius-tag); color:var(--color-text-secondary); background:var(--color-surface-subtle); font-size:var(--text-caption); }

.result-actions { display:flex; flex-direction:column; align-items:center; width:100%; box-sizing:border-box; gap:16rpx; margin:36rpx auto; padding:0; }
.result-actions button { display:flex; align-items:center; justify-content:center; width:100%; min-height:92rpx; box-sizing:border-box; margin:0; padding:8rpx 24rpx; line-height:1.2; text-align:center; }
.lead-actions { margin-top:var(--space-md); }
.pair-privacy { margin-top:2rpx; color:var(--color-text-muted-readable); font-size:var(--text-caption); line-height:1.5; text-align:center; }

.pairing { margin-top:var(--space-md); padding:32rpx 28rpx; border-top:7rpx solid var(--color-secondary); }
.pair-toggle { width:100%; min-height:44px; margin-top:var(--space-sm); color:var(--color-secondary-strong); background:transparent; }
.pair-manual-action { width:100%; min-height:86rpx; margin-top:var(--space-sm); }
.pair-code { margin:var(--space-sm) auto 0; padding:18rpx; border:3rpx dashed var(--color-secondary); border-radius:14rpx; color:var(--color-dark); background:var(--color-secondary-pale); font-family:monospace; font-size:48rpx; font-weight:900; letter-spacing:10rpx; text-align:center; }
.pair-copy { width:100%; min-height:44px; margin-top:8rpx; color:var(--color-secondary-strong); background:transparent; }
.pair-or { margin-top:var(--space-md); color:var(--color-text-muted-readable); font-size:var(--text-caption); text-align:center; }
.pair-input { box-sizing:border-box; width:100%; height:88rpx; margin-top:16rpx; padding:0 22rpx; border:2rpx dashed var(--color-secondary-soft); border-radius:var(--radius-control); color:var(--color-dark); background:#fcfaf7; font-family:monospace; font-size:32rpx; font-weight:800; letter-spacing:7rpx; text-align:center; }
.pair-input:focus { border-color:var(--color-focus); background:var(--color-secondary-pale); }
.pair-input.error { border-style:solid; border-color:var(--color-risk); background:var(--color-risk-soft); }
.pair-message { margin-top:16rpx; color:var(--color-text-secondary); font-size:23rpx; line-height:1.5; text-align:center; }
.tone-mark { color:inherit; }
.pair-message.error { color:var(--color-risk); }
.pair-message.success { color:var(--color-success); }

.relationship-participants { display:flex; flex-direction:column; gap:8rpx; margin-top:var(--space-md); color:var(--color-secondary-strong); font-size:var(--text-caption); font-weight:700; }
.relationship-title { margin-top:var(--space-sm); color:var(--color-text); font-size:var(--text-title); font-weight:900; line-height:1.25; }
.relationship-copy { margin-top:14rpx; color:var(--color-text-secondary); font-size:26rpx; line-height:1.72; }
.pair-actions { margin-top:var(--space-md); margin-bottom:0; }

.disclaimer { margin:32rpx 8rpx 0; white-space:pre-line; color:var(--color-text-muted-readable); font-size:var(--text-caption); line-height:1.7; text-align:center; }
.poster-canvas { position:fixed; z-index:-1; left:-9999px; top:-9999px; width:375px; height:600px; opacity:0; pointer-events:none; }

.reflection-backdrop { position:fixed; z-index:20; inset:0; display:flex; align-items:flex-end; padding:24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing:border-box; background:rgba(48,42,45,.34); animation:reflection-fade .2s ease-out; }
.reflection-modal { position:relative; width:100%; max-height:calc(100vh - 100rpx - env(safe-area-inset-bottom)); overflow-y:auto; padding:28rpx 24rpx 24rpx; box-sizing:border-box; border:1rpx solid var(--color-border); border-top:8rpx solid var(--color-primary); border-radius:30rpx 30rpx 22rpx 22rpx; background:var(--color-card); box-shadow:0 -16rpx 60rpx rgba(48,42,45,.16); animation:reflection-rise .26s ease-out; }
.reflection-accent { width:112rpx; height:10rpx; margin:0 auto 20rpx; border-bottom:5rpx solid var(--color-accent); border-radius:50%; transform:rotate(-2deg); }
.reflection-system-label { display:table; padding:7rpx 11rpx; border-radius:var(--radius-tag); color:var(--color-secondary-strong); background:var(--color-secondary-pale); font-size:17rpx; font-weight:800; letter-spacing:2rpx; }
.reflection-modal reflection-card { display:block; margin-top:16rpx; }
.reflection-close { position:sticky; bottom:0; display:flex; align-items:center; justify-content:center; width:100%; min-height:86rpx; box-sizing:border-box; margin:20rpx 0 0; color:var(--color-text-inverse); background:var(--color-primary-action); box-shadow:var(--shadow-action); text-align:center; }
.reflection-close:active { background:var(--color-primary-deep); }

@keyframes orbit-spin { to { transform:rotate(360deg); } }
@keyframes reflection-fade { from { opacity:0; } to { opacity:1; } }
@keyframes reflection-rise { from { opacity:0; transform:translateY(40rpx); } to { opacity:1; transform:translateY(0); } }
@keyframes reveal-in { from { opacity:0; transform:translateY(18rpx); } to { opacity:1; transform:translateY(0); } }
@media (max-height:650px) { .result-loading { padding-top:28rpx; } .loading-symbol { width:150rpx; height:150rpx; margin-top:16rpx; } .symbol-core { inset:43rpx; } }
