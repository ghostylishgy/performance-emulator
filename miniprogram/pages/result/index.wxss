.result-loading-page { display:flex; align-items:center; background:linear-gradient(160deg,#fff9fb 0,#f7f1ff 100%); }
.result-loading { width:100%; padding:38rpx 30rpx 34rpx; }
.loading-kicker { color:var(--color-secondary); font-size:17rpx; font-weight:700; letter-spacing:2rpx; text-align:center; }
.loading-symbol { position:relative; width:190rpx; height:190rpx; margin:30rpx auto 12rpx; }
.orbit { position:absolute; border:2rpx solid rgba(177,108,255,.26); border-radius:50%; }
.orbit::after { content:""; position:absolute; width:13rpx; height:13rpx; border-radius:50%; background:var(--color-primary); box-shadow:0 0 0 7rpx rgba(255,77,141,.10); }
.orbit-one { inset:10rpx; animation:orbit-spin 3.2s linear infinite; }
.orbit-one::after { right:18rpx; top:6rpx; }
.orbit-two { inset:34rpx; border-style:dashed; animation:orbit-spin 4.6s linear infinite reverse; }
.orbit-two::after { left:1rpx; bottom:27rpx; background:var(--color-accent-strong); }
.symbol-core { position:absolute; inset:57rpx; display:flex; align-items:center; justify-content:center; border-radius:32rpx 42rpx 30rpx 38rpx; color:#fff; background:linear-gradient(145deg,var(--color-primary),var(--color-secondary)); font-size:34rpx; font-weight:900; transform:rotate(-4deg); box-shadow:9rpx 9rpx 0 var(--color-accent); }
.symbol-spark { position:absolute; right:5rpx; bottom:16rpx; color:var(--color-primary); font-size:27rpx; }
.loading-title { margin-top:20rpx; color:var(--color-text); font-size:39rpx; font-weight:900; text-align:center; }
.loading-list { margin-top:38rpx; }
.loading-line { display:flex; align-items:flex-start; gap:17rpx; margin-top:24rpx; color:var(--color-text-muted); font-size:25rpx; line-height:1.5; transition:color .2s ease,transform .2s ease; }
.loading-line.active { color:var(--color-secondary); font-weight:700; transform:translateX(5rpx); }
.loading-line.done { color:var(--color-text-secondary); }
.loading-line.done .loading-status { color:var(--color-primary); }
.loading-status { flex:0 0 28rpx; width:28rpx; }
.loading-disclaimer { margin-top:36rpx; padding:22rpx 24rpx; border-radius:17rpx; color:#705819; background:#fff4c2; font-size:22rpx; line-height:1.65; text-align:center; }
@keyframes orbit-spin { to { transform:rotate(360deg); } }
.result-page { background:linear-gradient(180deg,#fff9fb 0,var(--color-page) 420rpx); }
.result-brand { display:flex; align-items:center; gap:10rpx; color:var(--color-text-secondary); font-size:20rpx; font-weight:700; }
.brand-dot { width:13rpx; height:13rpx; border-radius:50%; background:var(--color-primary); box-shadow:0 0 0 6rpx rgba(255,77,141,.10); }
.result-eyebrow { margin:28rpx 0 14rpx; text-align:center; }
.reveal-card { margin-top:28rpx; padding:34rpx 30rpx; animation:reveal-in .28s ease-out both; }
.persona-reveal { margin-top:34rpx; background:linear-gradient(145deg,#fff 0,#fff2f7 100%); }
.persona-name { margin-top:18rpx; color:var(--color-text); font-size:54rpx; font-weight:900; line-height:1.2; }
.persona-copy { margin-top:20rpx; color:var(--color-text-secondary); font-size:27rpx; line-height:1.75; }
.reveal-button { width:100%; min-height:88rpx; margin-top:24rpx; }
.death-reveal { border-color:rgba(255,191,63,.46); background:linear-gradient(145deg,#fffdf5,#fff8d8); }
.death-label { display:inline-block; margin-top:18rpx; padding:11rpx 17rpx; color:#6d5110; background:var(--color-accent); font-size:40rpx; font-weight:900; transform:rotate(-1deg); }
.death-note { margin-top:20rpx; color:#81703e; font-size:24rpx; }
.evidence-item { display:flex; align-items:flex-start; gap:18rpx; margin-top:24rpx; }
.evidence-index { flex:0 0 44rpx; display:flex; align-items:center; justify-content:center; width:44rpx; height:44rpx; border-radius:50%; color:#fff; background:var(--color-secondary); font-size:21rpx; font-weight:800; }
.evidence-text { color:var(--color-text); font-size:27rpx; line-height:1.65; }
.score-reveal { text-align:center; background:radial-gradient(circle at 80% 10%,rgba(215,184,255,.38),transparent 30%),#fff; }
.final-score { margin-top:14rpx; color:var(--color-primary); font-size:112rpx; font-weight:900; line-height:1.05; letter-spacing:-5rpx; }
.score-subtitle { color:var(--color-text); font-size:30rpx; font-weight:800; }
.score-meta { margin-top:20rpx; color:var(--color-text-muted); font-size:22rpx; }
.pairing { margin-top:28rpx; padding:32rpx 28rpx; }
.pair-button { width:100%; min-height:86rpx; margin-top:24rpx; }
.pair-code { margin:24rpx auto 0; padding:18rpx; border:3rpx dashed var(--color-secondary); border-radius:18rpx; color:var(--color-text); background:#f8f1ff; font-family:monospace; font-size:48rpx; font-weight:900; letter-spacing:10rpx; text-align:center; }
.pair-copy { width:100%; margin-top:8rpx; }
.pair-or { margin-top:28rpx; color:var(--color-text-muted); font-size:22rpx; text-align:center; }
.pair-input { box-sizing:border-box; width:100%; height:88rpx; margin-top:16rpx; padding:0 22rpx; border:2rpx solid var(--color-border); border-radius:18rpx; color:var(--color-text); background:#faf9fc; font-family:monospace; font-size:32rpx; letter-spacing:6rpx; text-align:center; }
.pair-message { margin-top:16rpx; color:var(--color-text-secondary); font-size:23rpx; text-align:center; }
.relationship { margin-top:24rpx; padding:26rpx; border-radius:20rpx; background:linear-gradient(135deg,#fff0f6,#f5ecff); }
.relationship-title { color:var(--color-text); font-size:38rpx; font-weight:900; }
.relationship-copy { margin-top:13rpx; color:var(--color-text-secondary); font-size:25rpx; line-height:1.7; }
.calibration,.metrics,.hidden { margin-top:28rpx; padding:32rpx 28rpx; }
.section-kicker { color:var(--color-secondary); font-size:17rpx; font-weight:700; letter-spacing:2rpx; }
.section-title { margin-top:7rpx; color:var(--color-text); font-size:34rpx; font-weight:900; }
.outcome-flow { margin-top:28rpx; }
.flow-row { display:flex; justify-content:space-between; align-items:center; padding:20rpx 22rpx; border-radius:18rpx; background:#faf8fc; }
.flow-row.final { border:2rpx solid rgba(255,77,141,.18); background:#fff2f7; }
.flow-label { color:var(--color-text-secondary); font-size:25rpx; }
.flow-value { color:var(--color-text); font-size:40rpx; font-weight:900; font-variant-numeric:tabular-nums; }
.flow-value.accent { color:var(--color-primary); }
.organization-action { display:flex; align-items:center; justify-content:center; gap:12rpx; margin:8rpx 0; color:var(--color-secondary); font-size:21rpx; }
.arrow { font-size:30rpx; font-weight:800; }
.reason { margin-top:22rpx; padding:22rpx 23rpx; border-radius:17rpx; color:#544d5c; background:#f5f1fa; font-size:25rpx; line-height:1.68; }
.reason-label { margin-bottom:8rpx; color:var(--color-secondary); font-size:19rpx; font-weight:800; letter-spacing:2rpx; }
.hidden { position:relative; overflow:hidden; border-color:rgba(255,191,63,.60); background:linear-gradient(135deg,#fff8d9,#fff 62%); }
.hidden::after { content:"✦"; position:absolute; right:24rpx; top:14rpx; color:var(--color-accent-strong); font-size:36rpx; }
.hidden-badge { display:inline-block; padding:7rpx 12rpx; color:#735713; background:var(--color-accent); font-size:19rpx; font-weight:800; transform:rotate(-2deg); }
.hidden-title { margin-top:18rpx; white-space:pre-line; color:var(--color-text); font-size:37rpx; font-weight:900; line-height:1.45; }
.hidden-copy { margin-top:14rpx; color:#756025; font-size:25rpx; line-height:1.6; }
.result-actions { display:flex; flex-direction:column; align-items:center; width:100%; box-sizing:border-box; gap:16rpx; margin:36rpx auto; padding:0; }
.result-actions button { display:flex; align-items:center; justify-content:center; width:100%; min-height:92rpx; box-sizing:border-box; margin:0; padding:8rpx 24rpx; line-height:1.2; text-align:center; }
.disclaimer { margin:32rpx 8rpx 0; white-space:pre-line; color:var(--color-text-muted); font-size:21rpx; line-height:1.7; text-align:center; }
.reflection-backdrop { position:fixed; z-index:20; inset:0; display:flex; align-items:flex-end; padding:24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing:border-box; background:rgba(34,24,52,.34); animation:reflection-fade .2s ease-out; }
.reflection-modal { position:relative; width:100%; max-height:calc(100vh - 100rpx - env(safe-area-inset-bottom)); overflow-y:auto; padding:28rpx 24rpx 24rpx; box-sizing:border-box; border:1rpx solid rgba(177,108,255,.18); border-radius:30rpx 30rpx 22rpx 22rpx; background:linear-gradient(165deg,#fffdfe 0,#fbf8fd 62%,#fff8fb 100%); box-shadow:0 -16rpx 60rpx rgba(52,36,70,.18); animation:reflection-rise .26s ease-out; }
.reflection-accent { width:112rpx; height:10rpx; margin:0 auto 20rpx; border-bottom:5rpx solid var(--color-accent); border-radius:50%; transform:rotate(-2deg); }
.reflection-system-label { padding:4rpx 8rpx 20rpx; color:#8a669a; font-size:18rpx; font-weight:700; letter-spacing:2rpx; }
.reflection-modal reflection-card { display:block; }
.reflection-close { position:sticky; bottom:0; display:flex; align-items:center; justify-content:center; width:100%; min-height:86rpx; box-sizing:border-box; margin:20rpx 0 0; color:#fff; background:linear-gradient(120deg,var(--color-primary),#ff659e); box-shadow:0 12rpx 30rpx rgba(255,77,141,.22); text-align:center; }
@keyframes reflection-fade { from { opacity:0; } to { opacity:1; } }
@keyframes reflection-rise { from { opacity:0; transform:translateY(40rpx); } to { opacity:1; transform:translateY(0); } }
@keyframes reveal-in { from { opacity:0; transform:translateY(18rpx); } to { opacity:1; transform:translateY(0); } }
@media (max-height:650px) {
  .result-loading { padding-top:28rpx; }
  .loading-symbol { width:150rpx; height:150rpx; margin-top:16rpx; }
  .symbol-core { inset:43rpx; }
}
