<view wx:if="{{loading}}" class="page-shell result-loading-page">
  <view class="result-loading panel">
    <view class="loading-kicker">烛龙实验室 · CALCULATION ENGINE</view>
    <view class="loading-symbol"><view class="orbit orbit-one"></view><view class="orbit orbit-two"></view><view class="symbol-core">烛</view><view class="symbol-spark">✦</view></view>
    <view class="loading-title">正在计算。大概。</view>
    <view class="loading-list">
      <view class="loading-line {{index === resultLineIndex ? 'active' : ''}} {{index < resultLineIndex ? 'done' : ''}}" wx:for="{{resultTransition.lines}}" wx:key="index">
        <text class="loading-status">{{index < resultLineIndex ? '✓' : (index === resultLineIndex ? '●' : '○')}}</text><text>{{item}}</text>
      </view>
    </view>
  </view>
</view>

<view wx:elif="{{ready}}" class="page-shell result-page">
  <view class="result-brand"><text class="brand-dot"></text>烛龙实验室｜绩效内测会</view>

  <view class="reveal-card persona-reveal panel">
    <view class="section-kicker">01 / 职场本体</view>
    <view class="persona-name">{{result.personaName}}</view>
    <view class="persona-copy">{{result.personaCopy}}</view>
  </view>

  <button wx:if="{{revealStage === 1}}" class="primary-button reveal-button" bindtap="revealNext">看看主要死因</button>

  <view wx:if="{{revealStage >= 2}}" class="reveal-card death-reveal panel">
    <view class="section-kicker">02 / 主要绩效死因</view>
    <view class="death-label">{{result.deathCauseLabel}}</view>
    <view class="death-note">同样是 3.5，死法各不相同。</view>
  </view>
  <button wx:if="{{revealStage === 2}}" class="primary-button reveal-button" bindtap="revealNext">查看系统抓包</button>

  <view wx:if="{{revealStage >= 3}}" class="reveal-card evidence-reveal panel">
    <view class="section-kicker">03 / 抓包证据</view>
    <view class="evidence-item" wx:for="{{result.evidence}}" wx:key="questionId">
      <view class="evidence-index">{{index + 1}}</view><view class="evidence-text">{{item.text}}</view>
    </view>
  </view>
  <button wx:if="{{revealStage === 3}}" class="primary-button reveal-button" bindtap="revealNext">最后看看绩效</button>

  <block wx:if="{{revealStage >= 4}}">
    <view class="reveal-card score-reveal panel">
      <view class="section-kicker">04 / 最终绩效</view>
      <view class="final-score">{{result.outcome}}</view>
      <view class="score-subtitle">{{result.outcomeSubtitle}}</view>
      <view class="score-meta">基础 {{result.baseOutcome}} · 组织校准 {{result.calibrationDelta > 0 ? '+1' : (result.calibrationDelta < 0 ? '-1' : '0')}} 档</view>
    </view>

    <view class="metrics panel"><view class="section-kicker">解释数据，不参与二次加权</view><view class="section-title">个人绩效五维</view><metric-bars metrics="{{result.metricBars}}" /></view>

    <view class="pairing panel">
      <view class="section-kicker">COLLEAGUE PROTOCOL</view><view class="section-title">和同事对个口径</view>
      <button class="secondary-button pair-button" loading="{{pairLoading}}" bindtap="generatePairCode">生成匿名对口径码</button>
      <view wx:if="{{pairCode}}" class="pair-code">{{pairCode}}</view>
      <view class="pair-or">或者输入同事的码</view>
      <input class="pair-input" maxlength="6" value="{{pairInput}}" placeholder="6位字母数字" bindinput="onPairInput" />
      <button class="primary-button pair-button" loading="{{pairLoading}}" bindtap="resolvePair">查看职场关系鉴定</button>
      <view wx:if="{{pairMessage}}" class="pair-message">{{pairMessage}}</view>
      <view wx:if="{{pairRelationship}}" class="relationship">
        <view class="relationship-title">{{pairRelationship.title}}</view><view class="relationship-copy">{{pairRelationship.copy}}</view>
      </view>
    </view>

    <view class="result-actions">
      <button class="primary-button" open-type="share" bindtap="shareIntent">发给同事看看</button>
      <button class="secondary-button" bindtap="restart">我不服，再测一次</button>
    </view>
    <view class="disclaimer">{{result.resultDisclaimer}}</view>
  </block>

  <view wx:if="{{reflectionVisible}}" class="reflection-backdrop" catchtap="noop" catchtouchmove="noop">
    <view class="reflection-modal" catchtap="noop">
      <view class="reflection-accent"></view><view class="reflection-system-label">SYSTEM MESSAGE / 系统稍微认真了一下</view>
      <reflection-card content="{{reflection}}" />
      <button class="reflection-close" bindtap="closeReflection">{{reflection.button}}</button>
    </view>
  </view>
</view>
