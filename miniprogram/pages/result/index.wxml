<view wx:if="{{loading}}" class="page-shell result-loading-page">
  <view class="result-loading panel">
    <view class="loading-kicker">组织内部计算流程</view>
    <view class="loading-mascot"><mascot scene="analysis" /></view>
    <view class="loading-title">正在计算。大概。</view>
    <view class="loading-active-line"><text class="loading-status">●</text><text class="loading-active-copy">{{activeCalculationLine}}</text></view>
    <view class="loading-progress" aria-label="计算进度">
      <view class="loading-progress-dot {{index <= resultLineIndex ? 'active' : ''}}" wx:for="{{resultTransition.lines}}" wx:key="index"></view>
    </view>
  </view>
</view>

<view wx:elif="{{ready}}" class="page-shell result-page">
  <view class="result-head">
    <view class="result-brand"><text class="brand-dot"></text>烛龙实验室｜绩效内测会</view>
    <view class="result-file-id">档案 · V3</view>
  </view>

  <view wx:if="{{revealStage >= 1}}" class="result-dossier">
    <view class="dossier-header"><text class="kicker-pill kicker-pill-brand">RESULT CONFIRMED</text><text class="dossier-record">档案结论</text></view>
    <view class="dossier-copy">
      <view class="persona-name">{{result.personaName}}</view>
      <view class="persona-copy">「{{result.personaCopy}}」</view>
    </view>
    <view class="dossier-verdicts">
      <view class="performance-block {{revealStage >= 2 ? 'is-stamped' : 'is-pending'}}">
        <view class="performance-seal"><view class="seal-label">最终绩效</view><view class="final-score">{{result.outcome}}</view></view>
        <view class="score-subtitle">{{result.outcomeSubtitle}}</view>
      </view>
      <view class="death-annotation">
        <view class="death-kicker">主要绩效死因</view>
        <view class="death-label">{{result.deathCauseLabel}}</view>
        <view class="death-note">同样是 3.5，死法不同。</view>
      </view>
    </view>
    <view class="score-meta">基础 {{result.baseOutcome}} · 组织校准 {{result.calibrationDelta > 0 ? '+1' : (result.calibrationDelta < 0 ? '-1' : '0')}} 档</view>
    <view wx:if="{{!pairRelationship}}" class="dossier-mascot"><mascot scene="result" /></view>
  </view>

  <view wx:if="{{revealStage >= 3}}" class="reveal-card evidence-reveal panel">
    <view class="section-kicker"><text class="kicker-pill">系统抓包</text></view>
    <view class="evidence-item" wx:for="{{result.evidence}}" wx:key="id">
      <view class="evidence-index">{{index + 1}}</view><view class="evidence-text">{{item.text}}</view>
    </view>
  </view>

  <block wx:if="{{revealStage >= 4}}">
    <view wx:if="{{!pairRelationship}}" class="result-actions lead-actions">
      <button class="primary-button" loading="{{posterSaving}}" disabled="{{posterSaving}}" bindtap="saveSinglePoster">保存我的结果卡</button>
      <button class="secondary-button" hover-class="text-pressed" open-type="share" bindtap="shareIntent" data-share-mode="invite">找个人来对一下口径</button>
      <view class="pair-privacy">只分享 5 位匿名码，不含答题记录。</view>
    </view>

    <view class="pairing panel">
      <view class="section-kicker"><text class="kicker-pill">职场关系鉴定</text><text class="kicker-note">仅本机运行</text></view>

      <block wx:if="{{!pairRelationship}}">
        <button wx:if="{{!manualPairExpanded}}" class="text-button pair-toggle" hover-class="text-pressed" bindtap="toggleManualPair">已有对口径码？手动输入 ▾</button>
        <view wx:if="{{manualPairExpanded}}" class="pair-manual">
          <button class="secondary-button pair-manual-action" hover-class="text-pressed" bindtap="generatePairCode">生成我的匿名码</button>
          <view wx:if="{{pairCode}}" class="pair-code">{{pairCode}}</view>
          <button wx:if="{{pairCode}}" class="text-button pair-copy" hover-class="text-pressed" bindtap="copyPairCode">复制匿名码</button>
          <view class="pair-or">或输入同事的 5 位码</view>
          <input class="pair-input {{pairMessageTone === 'error' ? 'error' : ''}}" maxlength="5" value="{{pairInput}}" placeholder="5 位对口径码" bindinput="onPairInput" />
          <button class="secondary-button pair-manual-action" hover-class="text-pressed" bindtap="resolvePair">鉴定你们的关系</button>
        </view>
        <view wx:if="{{pairMessage}}" class="pair-message {{pairMessageTone}}">
          <text wx:if="{{pairMessageTone === 'error'}}" class="tone-mark">⚠ </text>{{pairMessage}}
        </view>
      </block>

      <block wx:else>
        <view class="relationship-participants">
          <text>A｜{{pairRelationship.peerPersonaName}}</text><text>B｜{{pairRelationship.ownPersonaName}}</text>
        </view>
        <view class="relationship-title">{{pairRelationship.title}}</view>
        <view class="relationship-copy">{{pairRelationship.copy}}</view>
        <view class="result-actions pair-actions">
          <button class="primary-button" loading="{{posterSaving}}" disabled="{{posterSaving}}" bindtap="saveRelationshipPoster">保存关系卡</button>
          <button class="secondary-button" hover-class="text-pressed" open-type="share" bindtap="shareIntent" data-share-mode="invite">再找一个人对口径</button>
        </view>
      </block>
    </view>

    <view class="result-actions">
      <button class="secondary-button" bindtap="restart">我不服，再测一次</button>
    </view>
    <view class="disclaimer">{{result.resultDisclaimer}}</view>
  </block>

  <canvas type="2d" id="posterCanvas" class="poster-canvas"></canvas>

  <view wx:if="{{reflectionVisible}}" class="reflection-backdrop" catchtap="noop" catchtouchmove="noop">
    <view class="reflection-modal" catchtap="noop">
      <view class="reflection-accent"></view><view class="reflection-system-label">系统稍微认真了一下</view>
      <reflection-card content="{{reflection}}" />
      <button class="reflection-close" bindtap="closeReflection">{{reflection.button}}</button>
    </view>
  </view>
</view>
