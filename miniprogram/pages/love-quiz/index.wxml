<view class="quiz-page">
  <view class="quiz-head">
    <view class="agency">人间事故鉴定中心</view>
    <view class="counter">{{questionNumber}} / {{total}}</view>
  </view>
  <view class="progress-track"><view class="progress-fill" style="width: {{progressPercent}}%;"></view></view>
  <view class="question-file">
    <view class="question-id">{{question.id}}</view>
    <view class="question-title">{{question.title}}</view>
    <view class="question-prompt">{{question.prompt}}</view>
  </view>
  <view class="options">
    <button
      wx:for="{{question.options}}"
      wx:key="id"
      class="option {{selectedId === item.id ? 'option-selected' : ''}}"
      data-option-id="{{item.id}}"
      disabled="{{interactionLocked}}"
      bindtap="selectOption"
    >
      <text class="option-id">{{item.id}}</text>
      <text class="option-text">{{item.text}}</text>
    </button>
  </view>
  <button wx:if="{{canGoBack}}" class="back-button" disabled="{{interactionLocked}}" bindtap="goBack">返回上一题</button>
</view>
