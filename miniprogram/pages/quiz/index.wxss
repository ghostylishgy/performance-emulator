.quiz { padding-bottom:44rpx; }
.header { position:sticky; top:0; z-index:2; padding:8rpx 0 26rpx; background:#f4f6f9; }
.chapter { color:#263247; font-size:26rpx; font-weight:700; line-height:1.45; }
.chapter-subtitle { margin-top:4rpx; color:#7a8495; font-size:22rpx; }
.header quiz-progress { display:block; margin-top:20rpx; }
.question-wrap { margin-top:30rpx; }
.back { width:180rpx; margin:12rpx auto 0 0; padding:4rpx; color:#6a7485; background:transparent; font-size:25rpx; font-weight:400; }
.scan { margin-top:9vh; padding:42rpx 34rpx; }
.scan-title { color:#172033; font-size:35rpx; font-weight:700; }
.scan-list { margin-top:38rpx; }
.scan-line { display:flex; gap:18rpx; margin-top:26rpx; color:#9aa2af; font-size:27rpx; transition:color .2s ease; }
.scan-line.active { color:#2457d6; font-weight:600; }
.scan-line.done { color:#536074; }
.status { width:28rpx; }
.scan-disclaimer { margin-top:48rpx; padding-top:28rpx; border-top:1rpx solid #e3e8ef; color:#7a8494; font-size:23rpx; line-height:1.65; }

