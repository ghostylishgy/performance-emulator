.quiz { min-height:100vh; padding-bottom:calc(40rpx + env(safe-area-inset-bottom)); background:linear-gradient(180deg,#fffaf6 0,var(--color-page) 260rpx); }
.header { position:sticky; top:0; z-index:2; margin:0 -4rpx; padding:6rpx 4rpx 24rpx; border-bottom:1rpx solid rgba(228,218,212,.72); background:rgba(246,241,234,.95); }
.quiz-system-label { display:inline-flex; padding:7rpx 11rpx; border-radius:var(--radius-tag); color:var(--color-secondary-strong); background:var(--color-secondary-pale); font-size:17rpx; font-weight:800; letter-spacing:2rpx; }
.header quiz-progress { display:block; margin-top:22rpx; }
.question-wrap { margin-top:36rpx; animation:question-in .24s ease-out both; }
.back-row { display:flex; align-items:center; justify-content:flex-start; width:100%; box-sizing:border-box; margin-top:14rpx; }
.back { display:inline-flex; align-items:center; justify-content:flex-start; width:auto; box-sizing:border-box; margin:0; min-height:44px; padding:14rpx 26rpx; border:1rpx solid rgba(137,101,142,.24); border-radius:14rpx; color:var(--color-secondary-strong); background:var(--color-secondary-pale); font-size:23rpx; font-weight:700; line-height:1.2; text-align:left; }
.back-pressed { border-color:rgba(137,101,142,.42); background:#e7d9e9; transform:scale(.98); }
.quiz-footnote { display:flex; align-items:center; gap:10rpx; margin:24rpx 4rpx 0; color:var(--color-text-muted-readable); font-size:20rpx; white-space:nowrap; }
.record-dot { width:10rpx; height:10rpx; border-radius:50%; background:var(--color-success); box-shadow:0 0 0 6rpx var(--color-success-soft); }
@keyframes question-in { from { opacity:0; transform:translateY(12rpx); } to { opacity:1; transform:translateY(0); } }
