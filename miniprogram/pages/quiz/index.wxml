<view class="page-shell quiz">
  <view class="header">
    <view class="quiz-system-label">绩效内测进行中</view>
    <quiz-progress current="{{questionNumber}}" total="{{total}}" />
  </view>
  <view class="question-wrap">
    <question-card question="{{question}}" selected="{{selectedId}}" disabled="{{interactionLocked}}" bind:choose="selectOption" />
  </view>
  <view wx:if="{{canGoBack}}" class="back-row">
    <view class="back" hover-class="back-pressed" bindtap="goBack">← 上一题</view>
  </view>
  <view class="quiz-footnote"><text class="record-dot"></text>答案仅保存在本机</view>
  <view wx:if="{{leavingQuiz}}" class="quiz-exit-mask" aria-hidden="true"></view>
</view>
