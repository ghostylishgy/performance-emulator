@import "./styles/tokens.wxss";

page { min-height: 100%; background: #f5f2ec; color: #282527; }
.textbook-desk { box-sizing: border-box; min-height: 100vh; padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); background: var(--td-page); color: var(--td-text); }
.textbook-desk__setup, .textbook-desk__content, .textbook-desk__section { display: flex; flex-direction: column; gap: var(--td-space-3); margin-top: var(--td-space-4); }
.textbook-desk__section-title { color: var(--td-text); font-size: var(--td-text-body); font-weight: 650; }
