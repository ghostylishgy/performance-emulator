<view wx:if="{{ready}}" class="result-page">
  <view class="agency-bar">
    <text class="agency">人间事故鉴定中心</text>
    <text class="case-tag">CASE RESOLVED // 鉴定完毕</text>
  </view>

  <view wx:if="{{shareImageUrl}}" class="hero-photo-wrap">
    <view class="photo-tape">ACCIDENT SAMPLE</view>
    <image class="hero-photo" src="{{shareImageUrl}}" mode="widthFix" />
  </view>

  <view class="result-file">
    <view class="file-header">
      <view class="result-kicker">事故鉴定结果</view>
      <view class="file-id">NO. {{resultCard.personaId}}</view>
    </view>

    <view class="persona-title-group">
      <view class="persona-name">{{personaName}}</view>
    </view>

    <block wx:if="{{resultCard}}">
      <view class="headline">{{resultCard.headline}}</view>
      <view class="punchline">{{resultCard.punchline}}</view>

      <view class="metrics-panel">
        <view class="metrics-strip-title">PARMS // 行为取样特征</view>
        <view class="metrics-list">
          <view wx:for="{{resultCard.metrics}}" wx:key="label" class="metric-row">
            <text class="metric-label">{{item.label}}</text>
            <text class="metric-dots"></text>
            <text class="metric-value">{{item.value}}</text>
          </view>
        </view>
      </view>

      <view class="verdict-wrap">
        <view class="verdict-label">FINAL VERDICT // 鉴定意见</view>
        <view class="verdict">{{resultCard.verdict}}</view>
        <view class="stamp" aria-label="鉴定成立">鉴定成立</view>
      </view>
    </block>
  </view>

  <view class="actions-group">
    <view class="share-hook">事故责任已锁定，请尽快抄送有关涉事人员。</view>
    <button class="share-button" open-type="share">
      <text class="btn-text">分享我的事故鉴定书</text>
      <text class="btn-arrow">→</text>
    </button>
    <button class="retry-button" bindtap="retry">{{isPublicResult ? '轮到你了，接受事故鉴定 →' : '再测一次'}}</button>
  </view>

  <view class="entertainment-note">本测试仅供娱乐，不构成任何现实判断。</view>
</view>
