page { background: #F4F1EA; color: #111111; }
.result-page { box-sizing: border-box; min-height: 100vh; padding: 42rpx 32rpx calc(52rpx + env(safe-area-inset-bottom)); background: #F4F1EA; }
.agency { color: #183153; font-size: 22rpx; font-weight: 900; letter-spacing: 5rpx; }
.result-file { position: relative; margin-top: 34rpx; padding: 34rpx 30rpx 42rpx; border: 4rpx solid #111111; box-shadow: 10rpx 10rpx 0 #111111; overflow: hidden; }
.result-kicker { display: inline-block; padding: 8rpx 14rpx; color: #F4F1EA; background: #C1121F; font-size: 21rpx; font-weight: 950; letter-spacing: 4rpx; }
.red-rule { width: 86rpx; height: 8rpx; margin: 26rpx 0 28rpx; background: #C1121F; }
.persona-name { max-width: 100%; font-size: 54rpx; font-weight: 950; line-height: 1.18; word-break: break-all; }
.headline { margin-top: 28rpx; font-size: 32rpx; font-weight: 900; line-height: 1.48; }
.punchline { margin-top: 18rpx; font-size: 26rpx; font-weight: 550; line-height: 1.72; white-space: pre-line; }
.metrics { margin-top: 30rpx; border-top: 3rpx solid #111111; border-bottom: 3rpx solid #111111; }
.metric-row { display: flex; align-items: center; justify-content: space-between; gap: 22rpx; min-height: 76rpx; padding: 10rpx 4rpx; border-bottom: 2rpx solid rgba(17, 17, 17, .22); }
.metric-row:last-child { border-bottom: 0; }
.metric-label { flex: 1; color: #183153; font-size: 23rpx; font-weight: 800; line-height: 1.4; }
.metric-value { flex: 0 0 auto; max-width: 47%; color: #C1121F; font-size: 24rpx; font-weight: 950; line-height: 1.35; text-align: right; word-break: break-all; }
.verdict-label { margin-top: 32rpx; color: #183153; font-size: 20rpx; font-weight: 900; letter-spacing: 4rpx; }
.verdict { margin-top: 12rpx; padding-right: 100rpx; font-size: 27rpx; font-weight: 750; line-height: 1.68; }
.stamp { position: absolute; right: 24rpx; bottom: 22rpx; width: 92rpx; height: 92rpx; border: 5rpx double #C1121F; color: #C1121F; font-size: 23rpx; font-weight: 950; line-height: 92rpx; text-align: center; transform: rotate(-8deg); opacity: .92; }
.persona-visual { margin-top: 38rpx; }
.persona-visual-label { margin-bottom: 14rpx; color: #183153; font-size: 21rpx; font-weight: 900; letter-spacing: 3rpx; }
.persona-visual-image { display: block; width: 100%; height: auto; border: 3rpx solid #111111; background: #F4F1EA; box-sizing: border-box; }
.entertainment-note { margin-top: 28rpx; color: #77716A; font-size: 19rpx; line-height: 1.5; text-align: center; }
button.share-button, button.retry-button { width: 100% !important; min-height: 98rpx; margin-left: 0 !important; margin-right: 0 !important; border-radius: 0; font-size: 29rpx; font-weight: 900; letter-spacing: 4rpx; }
button.share-button::after, button.retry-button::after { border: none; }
button.share-button { margin-top: 20rpx; color: #F4F1EA; background: #C1121F; }
button.retry-button { margin-top: 22rpx; color: #111111; border: 3rpx solid #111111; background: transparent; }
