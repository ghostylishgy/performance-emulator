@import "../../styles/tokens.wxss";

.card { padding:26rpx 24rpx 30rpx; border:2rpx solid rgba(177,108,255,.16); border-radius:22rpx; background:linear-gradient(180deg,#fff 0,#fdfafd 100%); box-shadow:0 10rpx 30rpx rgba(92,64,120,.06); }
.title { position:relative; margin-bottom:30rpx; color:#292431; font-size:38rpx; font-weight:900; line-height:1.4; }
.title::after { content:""; display:block; width:190rpx; height:12rpx; margin-top:4rpx; border-bottom:5rpx solid var(--color-accent); border-radius:50%; transform:rotate(-2deg); }
.paragraph { margin-top:20rpx; white-space:pre-line; color:#514a58; font-size:27rpx; line-height:1.76; }
.paragraph.lead { color:#e8427e; font-weight:700; }
.footer { margin-top:34rpx; padding:24rpx 22rpx 0; border-top:1rpx solid rgba(177,108,255,.16); color:#795f86; font-size:23rpx; font-weight:600; line-height:1.65; }
