@import "../../styles/tokens.wxss";

.transition { position:relative; box-sizing:border-box; margin-top:9vh; padding:38rpx 34rpx 42rpx; overflow:hidden; border:1rpx solid var(--color-border); border-radius:26rpx; background:var(--color-card); box-shadow:var(--shadow-card); text-align:center; animation:transition-in .3s ease-out both; }
.transition-kicker { color:var(--color-primary); font-size:18rpx; font-weight:700; letter-spacing:2rpx; }
.check-visual { position:relative; width:190rpx; height:150rpx; margin:30rpx auto 12rpx; }
.check-card { position:absolute; left:36rpx; top:18rpx; display:flex; align-items:center; justify-content:center; width:120rpx; height:94rpx; border-radius:28rpx 36rpx 26rpx 34rpx; color:#fff; background:linear-gradient(145deg,var(--color-primary),var(--color-secondary)); font-size:45rpx; font-weight:900; transform:rotate(-5deg); box-shadow:12rpx 12rpx 0 var(--color-accent); }
.spark { position:absolute; color:var(--color-accent-strong); font-size:28rpx; }
.spark-one { right:0; top:6rpx; }
.spark-two { left:4rpx; bottom:8rpx; color:var(--color-secondary); font-size:22rpx; }
.title { margin-top:18rpx; color:var(--color-text); font-size:42rpx; font-weight:900; line-height:1.35; }
.title::after { content:""; display:block; width:160rpx; height:12rpx; margin:6rpx auto 0; border-bottom:5rpx solid var(--color-primary); border-radius:50%; transform:rotate(-2deg); }
.copy-block { margin-top:28rpx; }
.line { margin-top:9rpx; color:var(--color-text-secondary); font-size:28rpx; line-height:1.65; }
.continue-wrap { display:flex; align-items:center; justify-content:center; width:100%; box-sizing:border-box; margin-top:42rpx; }
.continue { display:flex; align-items:center; justify-content:center; width:100%; min-height:92rpx; box-sizing:border-box; margin:0; padding:8rpx 24rpx; color:#fff; background:linear-gradient(120deg,var(--color-primary),var(--color-secondary)); box-shadow:0 14rpx 32rpx rgba(177,108,255,.20); line-height:1.2; text-align:center; }
.hand-arrow { margin:14rpx 30rpx 0 0; color:var(--color-secondary); font-size:32rpx; text-align:right; transform:rotate(-8deg); }
@keyframes transition-in { from { opacity:0; transform:scale(.96) translateY(14rpx); } to { opacity:1; transform:scale(1) translateY(0); } }
@media (max-height:650px) {
  .transition { margin-top:12rpx; }
  .check-visual { height:120rpx; margin-top:16rpx; transform:scale(.84); }
}
