<view class="transition panel">
  <view class="transition-kicker">SYSTEM CHECKPOINT ✓</view>
  <view class="check-visual">
    <view class="check-card">OK</view>
    <view class="spark spark-one">✦</view>
    <view class="spark spark-two">✦</view>
  </view>
  <view class="title">{{transition.title}}</view>
  <view class="copy-block">
    <view class="line" wx:for="{{transition.lines}}" wx:key="index">{{item}}</view>
  </view>
  <view class="continue-wrap">
    <button class="continue" bindtap="continueNext">{{transition.continueLabel}}</button>
  </view>
  <view class="hand-arrow">⌁ ↗</view>
</view>
