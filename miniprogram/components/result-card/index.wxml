<view class="result panel {{result.outcome === '4.0' ? 'legend' : ''}}">
  <view wx:if="{{result.outcome === '4.0'}}" class="legend-alert">检测到异常绩效区间</view>
  <view class="label">本次绩效校准结果</view>
  <view class="outcome-wrap">
    <view class="outcome">{{result.outcome}}</view>
    <view class="outcome-stroke"></view>
    <view class="result-spark">✦</view>
  </view>
  <view class="subtitle">{{result.outcomeSubtitle}}</view>
  <view class="verdict-note">组织结论 · 已生成</view>
  <view class="divider"></view>
  <view class="persona-label">你的职场人格</view>
  <view class="persona-sticker"><view class="persona">{{result.personaName}}</view></view>
  <view class="copy">{{result.personaCopy}}</view>
</view>
