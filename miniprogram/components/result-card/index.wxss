@import "../../styles/tokens.wxss";

.result { position:relative; box-sizing:border-box; padding:38rpx 30rpx 40rpx; overflow:hidden; border:1rpx solid var(--color-border); border-radius:26rpx; background:var(--color-card); box-shadow:var(--shadow-card); text-align:center; animation:result-enter .38s ease-out both; }
.result::before { content:""; position:absolute; right:-45rpx; top:-60rpx; width:180rpx; height:180rpx; border:2rpx solid rgba(177,108,255,.14); border-radius:50%; box-shadow:0 0 0 26rpx rgba(177,108,255,.045); }
.label,.persona-label { position:relative; z-index:1; color:var(--color-text-secondary); font-size:23rpx; letter-spacing:1rpx; }
.outcome-wrap { position:relative; z-index:1; display:inline-block; margin-top:4rpx; }
.outcome { position:relative; z-index:1; color:var(--color-primary); font-size:132rpx; font-weight:900; line-height:1.08; letter-spacing:-6rpx; text-shadow:6rpx 7rpx 0 rgba(177,108,255,.11); }
.outcome-stroke { position:absolute; left:0; right:-8rpx; bottom:4rpx; height:18rpx; border-bottom:7rpx solid var(--color-accent); border-radius:50%; transform:rotate(-2deg); }
.result-spark { position:absolute; right:-38rpx; top:4rpx; color:var(--color-accent-strong); font-size:32rpx; }
.subtitle { position:relative; z-index:1; max-width:560rpx; margin:8rpx auto 0; color:var(--color-text); font-size:38rpx; font-weight:900; line-height:1.42; }
.verdict-note { display:inline-block; margin-top:18rpx; padding:8rpx 14rpx; color:#6f571c; background:var(--color-accent); font-size:19rpx; font-weight:800; transform:rotate(-1.5deg); }
.divider { height:1rpx; margin:34rpx 0 30rpx; background:var(--color-border); }
.persona-sticker { display:inline-block; margin-top:14rpx; padding:8rpx 18rpx 10rpx; border-radius:13rpx; background:var(--color-dark); transform:rotate(-1deg); box-shadow:7rpx 7rpx 0 var(--color-secondary-soft); }
.persona { color:#fff; font-size:40rpx; font-weight:900; }
.copy { position:relative; z-index:1; margin-top:24rpx; padding:20rpx 22rpx; border-left:6rpx solid var(--color-primary); border-radius:0 16rpx 16rpx 0; color:#403a47; background:#fff3f7; font-size:28rpx; font-weight:600; line-height:1.65; text-align:left; }
.legend { border-color:rgba(255,191,63,.65); background:linear-gradient(145deg,#fff 0,#fff8d8 100%); }
.legend .outcome { color:var(--color-primary); text-shadow:6rpx 7rpx 0 rgba(255,191,63,.24); }
.legend-alert { display:inline-block; margin-bottom:18rpx; padding:8rpx 14rpx; color:#705612; background:var(--color-accent); font-size:20rpx; font-weight:900; letter-spacing:1rpx; transform:rotate(-2deg); }
@keyframes result-enter { from { opacity:0; transform:translateY(18rpx) scale(.985); } to { opacity:1; transform:translateY(0) scale(1); } }
