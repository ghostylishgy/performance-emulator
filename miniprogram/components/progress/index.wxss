@import "../../styles/tokens.wxss";

.wrap { display:flex; align-items:center; gap:20rpx; }
.track { flex:1; height:9rpx; overflow:hidden; border-radius:12rpx; background:var(--color-border); }
.fill { position:relative; height:100%; border-radius:12rpx; background:var(--color-primary); transition:width .25s ease; }
.glow { position:absolute; top:0; right:0; width:30rpx; height:100%; background:var(--color-accent); }
.count { color:var(--color-text-secondary); font-size:22rpx; font-weight:600; font-variant-numeric:tabular-nums; letter-spacing:1rpx; }
