.wrap { display:flex; align-items:center; gap:20rpx; }
.track { flex:1; height:7rpx; overflow:hidden; border-radius:10rpx; background:#dfe4ec; }
.fill { height:100%; border-radius:10rpx; background:#2457d6; transition:width .25s ease; }
.count { color:#647084; font-size:23rpx; font-variant-numeric:tabular-nums; }

