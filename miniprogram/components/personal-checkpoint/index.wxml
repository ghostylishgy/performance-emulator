<view class="checkpoint panel">
  <view class="status">个人阶段校验完成</view>
  <view class="title">{{checkpoint.title}}</view>
  <view class="label">个人努力建议绩效</view>
  <view class="outcome-wrap">
    <view class="outcome">{{outcome}}</view>
    <view class="outcome-stroke"></view>
    <view class="outcome-spark">✦</view>
  </view>
  <view class="note">{{note}}</view>
  <view class="subtitle">{{checkpoint.subtitle}}</view>
  <view class="actions">
    <button class="secondary" bindtap="back">{{checkpoint.backLabel}}</button>
    <button class="primary" bindtap="confirm">{{checkpoint.confirmLabel}}</button>
  </view>
</view>
