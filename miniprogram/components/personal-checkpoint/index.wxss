.checkpoint { margin-top:8vh; padding:46rpx 34rpx; text-align:center; }
.status { color:#2457d6; font-size:23rpx; letter-spacing:2rpx; }
.title { margin-top:22rpx; color:#263247; font-size:31rpx; font-weight:600; }
.label { margin-top:52rpx; color:#687386; font-size:25rpx; }
.outcome { margin-top:8rpx; color:#172033; font-size:108rpx; font-weight:800; line-height:1.2; letter-spacing:-3rpx; }
.subtitle { margin-top:28rpx; color:#687386; font-size:27rpx; }
.actions { display:flex; gap:18rpx; margin-top:48rpx; }
.actions button { flex:1; padding:8rpx; }
.secondary { color:#334155; background:#e9edf3; }
.primary { color:#fff; background:#2457d6; }

