@import "../../styles/tokens.wxss";

.checkpoint { box-sizing:border-box; margin-top:3vh; padding:36rpx 30rpx 34rpx; border:1rpx solid var(--color-border); border-radius:26rpx; background:var(--color-card); box-shadow:var(--shadow-card); text-align:center; animation:checkpoint-in .34s ease-out both; }
.status { display:inline-block; padding:8rpx 16rpx; border-radius:999rpx; color:var(--color-primary); background:#fff0f6; font-size:20rpx; font-weight:700; letter-spacing:1rpx; }
.title { max-width:560rpx; margin:26rpx auto 0; color:var(--color-text); font-size:40rpx; font-weight:900; line-height:1.42; }
.label { margin-top:34rpx; color:var(--color-text-secondary); font-size:25rpx; }
.outcome-wrap { position:relative; display:inline-block; margin-top:4rpx; }
.outcome { position:relative; z-index:1; color:var(--color-primary); font-size:126rpx; font-weight:900; line-height:1.12; letter-spacing:-5rpx; text-shadow:5rpx 6rpx 0 rgba(177,108,255,.10); }
.outcome-stroke { position:absolute; z-index:0; left:2%; right:0; bottom:8rpx; height:18rpx; border-bottom:7rpx solid var(--color-accent); border-radius:50%; transform:rotate(-2deg); }
.outcome-spark { position:absolute; right:-34rpx; top:12rpx; color:var(--color-accent-strong); font-size:34rpx; transform:rotate(8deg); }
.note { margin-top:24rpx; padding:22rpx 24rpx; white-space:pre-line; border:2rpx solid rgba(177,108,255,.24); border-radius:18rpx; color:#6645a0; background:#fbf7ff; font-size:25rpx; line-height:1.65; text-align:left; }
.subtitle { margin-top:20rpx; color:var(--color-text-muted); font-size:22rpx; }
.actions { display:flex; gap:16rpx; margin-top:34rpx; }
.actions button { flex:1; min-width:0; min-height:88rpx; padding:8rpx 4rpx; font-size:25rpx; white-space:nowrap; }
.secondary { color:var(--color-primary); border:2rpx solid rgba(255,77,141,.45); background:#fff; }
.primary { color:#fff; background:linear-gradient(120deg,var(--color-primary),#ff689f); box-shadow:0 12rpx 28rpx rgba(255,77,141,.20); }
@keyframes checkpoint-in { from { opacity:0; transform:translateY(18rpx); } to { opacity:1; transform:translateY(0); } }
@media (max-height:650px) {
  .checkpoint { margin-top:0; }
  .title { margin-top:18rpx; font-size:36rpx; }
  .label { margin-top:22rpx; }
  .outcome { font-size:106rpx; }
}
