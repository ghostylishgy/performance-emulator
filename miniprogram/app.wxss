@import "styles/tokens.wxss";

page {
  min-height: 100%;
  background: var(--color-page);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  font-size: 28rpx;
}

button {
  border-radius: var(--radius-control);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: .2rpx;
}

button::after { border: none; }

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
}

.primary-button {
  color: var(--color-text-inverse);
  background: linear-gradient(135deg, #ef6094, var(--color-primary));
  box-shadow: var(--shadow-action);
}

.primary-button:active { background:var(--color-primary-strong); transform:translateY(2rpx); box-shadow:0 7rpx 18rpx rgba(201,54,111,.18); }

.secondary-button {
  color: var(--color-primary);
  border: 2rpx solid rgba(233, 79, 135, 0.38);
  background: var(--color-card);
}

.secondary-button:active { color:var(--color-primary-strong); border-color:var(--color-primary); background:var(--color-primary-pale); }

button[disabled] { color:var(--color-disabled-text) !important; border-color:transparent !important; background:var(--color-disabled) !important; box-shadow:none !important; }

.eyebrow {
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.panel {
  box-sizing: border-box;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.system-tag { display:inline-flex; align-items:center; padding:7rpx 11rpx; border-radius:var(--radius-tag); color:var(--color-secondary-strong); background:var(--color-secondary-pale); font-size:17rpx; font-weight:800; letter-spacing:2rpx; }
.paper-stamp { display:inline-flex; align-items:center; padding:7rpx 12rpx; border:2rpx solid currentColor; border-radius:6rpx; color:var(--color-primary); font-size:17rpx; font-weight:900; letter-spacing:2rpx; transform:rotate(-1.5deg); }
.status-strip { box-sizing:border-box; padding:18rpx 21rpx; border:1rpx solid rgba(220,174,55,.34); border-radius:14rpx; color:#765b20; background:var(--color-accent-soft); font-size:23rpx; line-height:1.6; }
