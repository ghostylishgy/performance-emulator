@import "styles/tokens.wxss";

page {
  min-height: 100%;
  background: var(--color-page);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  font-size: 28rpx;
}

button {
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
}

button::after { border: none; }

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
}

.primary-button {
  color: #fff;
  background: linear-gradient(120deg, var(--color-primary), #ff629d);
  box-shadow: 0 14rpx 34rpx rgba(255, 77, 141, 0.24);
}

.secondary-button {
  color: var(--color-primary);
  border: 2rpx solid rgba(255, 77, 141, 0.45);
  background: var(--color-card);
}

.eyebrow {
  color: var(--color-primary);
  font-size: 22rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.panel {
  box-sizing: border-box;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
  box-shadow: var(--shadow-card);
}
