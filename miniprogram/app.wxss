page {
  min-height: 100%;
  background: #f4f6f9;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  font-size: 28rpx;
}

button {
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
}

button::after { border: none; }

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 40rpx 32rpx 64rpx;
}

.primary-button {
  color: #fff;
  background: #2457d6;
  box-shadow: 0 12rpx 30rpx rgba(36, 87, 214, 0.18);
}

.secondary-button {
  color: #334155;
  background: #e9edf3;
}

.eyebrow {
  color: #687386;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.panel {
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid #e3e8f0;
  border-radius: 22rpx;
  box-shadow: 0 14rpx 40rpx rgba(23, 32, 51, 0.06);
}

